{
  "type": "state",
  "title": "Purchase order",
  "description": "Lifecycle of a purchase order: the happy path runs from Draft to Delivered; rejected and cancelled orders leave it.",
  "states": [
    { "id": "start", "kind": "initial" },
    { "id": "draft", "label": "Draft" },
    { "id": "submitted", "label": "Submitted" },
    { "id": "approved", "label": "Approved" },
    { "id": "paid", "label": "Paid" },
    { "id": "shipped", "label": "Shipped" },
    { "id": "delivered", "label": "Delivered" },
    { "id": "rejected", "label": "Rejected", "kind": "exception" },
    { "id": "cancelled", "label": "Cancelled", "kind": "exception" },
    { "id": "end", "kind": "final" }
  ],
  "transitions": [
    "start -> draft: create",
    "draft -> draft: edit",
    "draft -> submitted: submit",
    "submitted -> approved: approve",
    "submitted -> rejected: reject",
    "rejected -> draft: revise",
    "approved -> paid: pay",
    "paid -> shipped: ship",
    "shipped -> delivered: deliver",
    "delivered -> end: close",
    "draft -> cancelled: cancel",
    "submitted -> cancelled: cancel",
    "approved -> cancelled: cancel",
    "cancelled -> end: close"
  ]
}
